<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  설치:
    sed "s|__PROJECT__|$PWD|g" scripts/com.codysey.dailylog.plist \
      > ~/Library/LaunchAgents/com.codysey.dailylog.plist
    launchctl load ~/Library/LaunchAgents/com.codysey.dailylog.plist

  해제:
    launchctl unload ~/Library/LaunchAgents/com.codysey.dailylog.plist

  맥이 잠들어 있으면 깨어난 뒤에 실행되므로 초안 시각이 밀릴 수 있다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.codysey.dailylog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT__/scripts/draft.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
